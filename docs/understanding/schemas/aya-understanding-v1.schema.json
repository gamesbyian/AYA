{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AYA Host Concept Model v1",
  "type": "object",
  "required": [
    "schema_version",
    "host",
    "thesis",
    "concepts",
    "goals",
    "principles",
    "claims",
    "ambiguities"
  ],
  "properties": {
    "schema_version": {
      "const": "aya-understanding/v1"
    },
    "host": {
      "type": "object",
      "required": [
        "app_id",
        "app_version",
        "source_revision"
      ],
      "properties": {
        "app_id": {
          "type": "string",
          "minLength": 1
        },
        "app_version": {
          "type": "string",
          "minLength": 1
        },
        "source_revision": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "thesis": {
      "type": "object",
      "required": [
        "statement",
        "source_ref",
        "truth_kind",
        "status"
      ],
      "properties": {
        "statement": {
          "type": "string"
        },
        "source_ref": {
          "type": "string"
        },
        "truth_kind": {
          "enum": [
            "intention",
            "implemented",
            "observed",
            "expectation"
          ]
        },
        "status": {
          "enum": [
            "confirmed",
            "provisional",
            "unknown"
          ]
        }
      }
    },
    "concepts": {
      "type": "array",
      "minItems": 1
    },
    "goals": {
      "type": "array",
      "minItems": 1
    },
    "principles": {
      "type": "array",
      "minItems": 1
    },
    "claims": {
      "type": "array",
      "minItems": 1
    },
    "ambiguities": {
      "type": "array"
    }
  }
}
