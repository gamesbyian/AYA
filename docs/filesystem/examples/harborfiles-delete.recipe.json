{
  "format": "harborfiles-recipe/v1",
  "target": {
    "root": "/",
    "recursive": true
  },
  "selection": {
    "extensions": [
      ".txt",
      ".rtf"
    ],
    "exclude_basenames": [
      "pomegranate.txt"
    ],
    "case_sensitive": false
  },
  "preconditions": {
    "protected_basename_must_exist": "pomegranate.txt",
    "require_complete_scan": true
  },
  "action": {
    "type": "delete"
  },
  "execution": {
    "dry_run": true,
    "require_approval": true,
    "revalidate": true
  }
}
