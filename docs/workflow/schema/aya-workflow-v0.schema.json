{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gamesbyian/AYA/blob/main/docs/workflow/schema/aya-workflow-v0.schema.json",
  "title": "Experimental AYA host-owned workflow definition v0",
  "description": "Normative shape for the experimental reference subset; semantic validation (IDs, cycles, applicability) is handled separately.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "title",
    "questions",
    "rules"
  ],
  "properties": {
    "schema": {
      "const": "aya-workflow/v0"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/question"
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rule"
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/conflict"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "condition": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "propertyNames": {
        "minLength": 1
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "prompt",
        "options"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "options": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": {
          "type": "boolean"
        },
        "default": {
          "type": "string"
        },
        "when": {
          "$ref": "#/$defs/condition"
        }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "section",
        "text"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "section": {
          "enum": [
            "objective",
            "operations",
            "constraints",
            "output"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "when": {
          "$ref": "#/$defs/condition"
        }
      }
    },
    "conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "when",
        "message"
      ],
      "properties": {
        "when": {
          "allOf": [
            {
              "$ref": "#/$defs/condition"
            },
            {
              "minProperties": 1
            }
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
