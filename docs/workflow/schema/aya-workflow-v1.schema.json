{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AYA experimental workflow v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "title",
    "questions",
    "rules"
  ],
  "properties": {
    "schema": {
      "const": "aya-workflow/v1"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/question"
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rule"
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/conflict"
      }
    }
  },
  "$defs": {
    "predicate": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "question",
            "equals"
          ],
          "properties": {
            "question": {
              "type": "string",
              "minLength": 1
            },
            "equals": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "boolean"
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "question",
            "contains"
          ],
          "properties": {
            "question": {
              "type": "string",
              "minLength": 1
            },
            "contains": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "all"
          ],
          "properties": {
            "all": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/predicate"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "any"
          ],
          "properties": {
            "any": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/predicate"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "not"
          ],
          "properties": {
            "not": {
              "$ref": "#/$defs/predicate"
            }
          }
        }
      ]
    },
    "question": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "prompt",
            "kind"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "prompt": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "const": "boolean"
            },
            "required": {
              "type": "boolean"
            },
            "default": {
              "type": "boolean"
            },
            "when": {
              "$ref": "#/$defs/predicate"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "prompt",
            "kind",
            "options"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "prompt": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "const": "choice"
            },
            "required": {
              "type": "boolean"
            },
            "default": {
              "type": "string"
            },
            "when": {
              "$ref": "#/$defs/predicate"
            },
            "options": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "prompt",
            "kind",
            "options"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "prompt": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "const": "multi"
            },
            "required": {
              "type": "boolean"
            },
            "default": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "when": {
              "$ref": "#/$defs/predicate"
            },
            "options": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "section",
        "text"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "section": {
          "enum": [
            "objective",
            "operations",
            "constraints",
            "output"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "when": {
          "$ref": "#/$defs/predicate"
        },
        "after": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "when",
        "message"
      ],
      "properties": {
        "when": {
          "$ref": "#/$defs/predicate"
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
