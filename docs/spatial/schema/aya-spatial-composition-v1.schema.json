{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AYA Spatial Composition v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "source",
    "annotations",
    "assets",
    "operations",
    "constraints",
    "instructions"
  ],
  "properties": {
    "format": {
      "const": "aya-spatial-composition/v1"
    },
    "source": {
      "$ref": "#/$defs/image"
    },
    "overlay": {
      "$ref": "#/$defs/image"
    },
    "annotations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "$ref": "#/$defs/annotation"
      }
    },
    "assets": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/asset"
      }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "$ref": "#/$defs/operation"
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preserveUnmarked",
        "engineeringVerified"
      ],
      "properties": {
        "preserveUnmarked": {
          "const": true
        },
        "engineeringVerified": {
          "const": false
        },
        "protectedAnnotationIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      }
    },
    "instructions": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12000
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
    },
    "path": {
      "type": "string",
      "pattern": "^(source|references|overlays)/[A-Za-z0-9_-]+(?:/[A-Za-z0-9_.-]+)*\\.(?:jpg|jpeg|png|webp)$",
      "maxLength": 256
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "mime",
        "sha256",
        "bytes",
        "width",
        "height"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "mime": {
          "enum": [
            "image/jpeg",
            "image/png",
            "image/webp"
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20971520
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32768
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32768
        }
      }
    },
    "coord": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "$ref": "#/$defs/coord"
        },
        "y": {
          "$ref": "#/$defs/coord"
        }
      }
    },
    "geometry": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "point"
          ],
          "properties": {
            "kind": {
              "const": "point"
            },
            "point": {
              "$ref": "#/$defs/point"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "vertices"
          ],
          "properties": {
            "kind": {
              "const": "polygon"
            },
            "vertices": {
              "type": "array",
              "minItems": 3,
              "maxItems": 500,
              "items": {
                "$ref": "#/$defs/point"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "x",
            "y",
            "width",
            "height"
          ],
          "properties": {
            "kind": {
              "const": "rect"
            },
            "x": {
              "$ref": "#/$defs/coord"
            },
            "y": {
              "$ref": "#/$defs/coord"
            },
            "width": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            },
            "height": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            }
          }
        }
      ]
    },
    "annotation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "geometry"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "geometry": {
          "$ref": "#/$defs/geometry"
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "category",
        "views"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "dimensionsMm": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "width",
            "height",
            "depth"
          ],
          "properties": {
            "width": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "height": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "depth": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "views": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "angle",
              "image"
            ],
            "properties": {
              "angle": {
                "enum": [
                  "front",
                  "rear",
                  "left",
                  "right",
                  "three-quarter",
                  "detail",
                  "other"
                ]
              },
              "image": {
                "$ref": "#/$defs/image"
              }
            }
          }
        }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targetAnnotationId",
        "kind"
      ],
      "properties": {
        "targetAnnotationId": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "replace",
            "add",
            "remove",
            "clean",
            "modify"
          ]
        },
        "assetId": {
          "$ref": "#/$defs/id"
        },
        "detail": {
          "type": "string",
          "maxLength": 2000
        }
      }
    }
  }
}
