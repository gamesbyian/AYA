{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gamesbyian/AYA/blob/main/docs/protocol/aya-handoff-v1.schema.json",
  "title": "AYA portable host-to-handoff manifest v1",
  "description": "An opt-in, review-before-share host SDK interchange model. It is not an Android receiver intent, not an assistant command protocol, and is not transmitted automatically.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "operation",
    "host",
    "request",
    "reference",
    "privacy"
  ],
  "properties": {
    "protocol": {
      "const": "aya-handoff/v1"
    },
    "operation": {
      "enum": [
        "help",
        "generate_image"
      ]
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packageId",
        "appName",
        "appVersion"
      ],
      "properties": {
        "packageId": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\\\.[A-Za-z][A-Za-z0-9_]*)+$",
          "maxLength": 200
        },
        "appName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "appVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "screen": {
          "type": "string",
          "maxLength": 200
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "userReviewRequired"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2097152
        },
        "userReviewRequired": {
          "const": true
        }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "asset",
        "exactInstalledVersionRequired"
      ],
      "properties": {
        "schema": {
          "const": "aya-reference/v1"
        },
        "asset": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "exactInstalledVersionRequired": {
          "const": true
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "visibleFeature": {
          "type": "string",
          "maxLength": 200
        },
        "subject": {
          "type": "string",
          "maxLength": 500
        }
      }
    },
    "outputRequirements": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "aspectWidth",
            "aspectHeight",
            "acceptedMimeTypes",
            "manualImport"
          ],
          "properties": {
            "aspectWidth": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "aspectHeight": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "preferredWidthPx": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16384
            },
            "preferredHeightPx": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16384
            },
            "acceptedMimeTypes": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "image/png",
                  "image/jpeg",
                  "image/webp"
                ]
              }
            },
            "manualImport": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            "safeMarginPercent": {
              "type": "integer",
              "minimum": 0,
              "maximum": 40
            },
            "transparentBackground": {
              "type": "boolean"
            }
          },
          "dependentRequired": {
            "preferredWidthPx": [
              "preferredHeightPx"
            ],
            "preferredHeightPx": [
              "preferredWidthPx"
            ]
          }
        }
      }
    },
    "attachments": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "mimeType",
          "displayName",
          "reviewRequired"
        ],
        "properties": {
          "role": {
            "enum": [
              "reference",
              "user_selected_media",
              "supplementary_context"
            ]
          },
          "mimeType": {
            "type": "string",
            "minLength": 3,
            "maxLength": 100
          },
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "byteLength": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2097152
          },
          "reviewRequired": {
            "const": true
          }
        }
      }
    },
    "transportPreferences": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "TEXT_ONLY",
          "TEXT_AND_TXT_REFERENCE",
          "TXT_REFERENCE_ONLY",
          "IMAGE_ATTACHMENT",
          "MULTIPLE_ATTACHMENTS",
          "PROCESS_TEXT"
        ]
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "explicitShareAction",
        "noAgentResponseCollection",
        "noAutomaticReturn"
      ],
      "properties": {
        "explicitShareAction": {
          "const": true
        },
        "noAgentResponseCollection": {
          "const": true
        },
        "noAutomaticReturn": {
          "const": true
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "const": "generate_image"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "required": [
          "outputRequirements"
        ],
        "properties": {
          "outputRequirements": {
            "required": [
              "image"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "help"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "not": {
          "properties": {
            "outputRequirements": {
              "required": [
                "image"
              ]
            }
          },
          "required": [
            "outputRequirements"
          ]
        }
      }
    }
  ]
}
