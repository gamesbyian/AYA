{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AYA Packet Source v1",
  "description": "Build-time fact source. Passing this schema does not establish factual truth.",
  "type": "object",
  "required": [
    "schema_version",
    "host",
    "facts"
  ],
  "properties": {
    "schema_version": {
      "const": "aya-packet-source/v1"
    },
    "host": {
      "type": "object",
      "required": [
        "app_id",
        "app_name",
        "app_version",
        "source_revision"
      ],
      "properties": {
        "app_id": {
          "type": "string",
          "minLength": 1
        },
        "app_name": {
          "type": "string",
          "minLength": 1
        },
        "app_version": {
          "type": "string",
          "minLength": 1
        },
        "source_revision": {
          "type": "string",
          "minLength": 1
        },
        "build_variant": {
          "type": "string"
        }
      }
    },
    "facts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "summary",
          "details",
          "status",
          "applies_to",
          "impacts",
          "profiles",
          "depends_on",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^FACT-[0-9]{3,}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "details": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "AVAILABLE",
              "CONDITIONAL",
              "EXPERIMENTAL",
              "PLANNED",
              "REMOVED",
              "UNSUPPORTED",
              "UNKNOWN"
            ]
          },
          "applies_to": {
            "type": "string",
            "minLength": 1
          },
          "impacts": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "ordinary",
                "technical",
                "accessibility",
                "privacy",
                "security",
                "destructive",
                "financial"
              ]
            }
          },
          "profiles": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "help",
                "creative",
                "structured",
                "translation"
              ]
            }
          },
          "depends_on": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^FACT-[0-9]{3,}$"
            }
          },
          "evidence": {
            "type": "object",
            "required": [
              "kind",
              "ref",
              "verified_at"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "released_binary",
                  "acceptance_test",
                  "source_code",
                  "official_contract",
                  "external",
                  "plan",
                  "unknown"
                ]
              },
              "ref": {
                "type": "string",
                "minLength": 1
              },
              "verified_at": {
                "type": "string",
                "format": "date-time"
              },
              "fresh_until": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      }
    }
  }
}
