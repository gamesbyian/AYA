{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AYA Packet Independent Inventory v1",
  "type": "object",
  "required": [
    "schema_version",
    "app_id",
    "app_version",
    "source_revision",
    "items"
  ],
  "properties": {
    "schema_version": {
      "const": "aya-packet-inventory/v1"
    },
    "app_id": {
      "type": "string"
    },
    "app_version": {
      "type": "string"
    },
    "source_revision": {
      "type": "string"
    },
    "inventory_method": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "profiles",
          "criticality",
          "source_ref"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^FACT-[0-9]{3,}$"
          },
          "profiles": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "help",
                "creative",
                "structured",
                "translation",
                "filesystem"
              ]
            }
          },
          "criticality": {
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "source_ref": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
