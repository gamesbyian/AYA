{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AYA SDK-independent handoff event trace",
  "description": "Metadata-only declaration of six local lifecycle cases. Structural schema validation is not runtime or recipient evidence; use the Python semantic-order checker too.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "host",
    "cases"
  ],
  "properties": {
    "schema": {
      "const": "aya-interaction-trace/v1"
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "app_id",
        "app_version",
        "source_revision",
        "platform"
      ],
      "properties": {
        "app_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z][A-Za-z0-9_]*)+$"
        },
        "app_version": {
          "type": "string",
          "pattern": "^[0-9A-Za-z][0-9A-Za-z._+-]{0,63}$"
        },
        "source_revision": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,100}$"
        },
        "platform": {
          "const": "android"
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scenario",
          "events"
        ],
        "properties": {
          "scenario": {
            "enum": [
              "review_share",
              "review_copy",
              "cancel",
              "version_mismatch",
              "no_receiver",
              "no_activity"
            ]
          },
          "events": {
            "type": "array",
            "minItems": 1,
            "maxItems": 24,
            "items": {
              "enum": [
                "reference_validated",
                "reference_rejected",
                "question_opened",
                "review_opened",
                "review_edited",
                "review_approved",
                "review_cancelled",
                "copy_requested",
                "copy_succeeded",
                "share_requested",
                "chooser_opened",
                "share_unavailable",
                "activity_detached",
                "local_rejected"
              ]
            }
          }
        }
      },
      "allOf": [
        {
          "contains": {
            "type": "object",
            "properties": {
              "scenario": {
                "const": "review_share"
              }
            },
            "required": [
              "scenario"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "scenario": {
                "const": "review_copy"
              }
            },
            "required": [
              "scenario"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "scenario": {
                "const": "cancel"
              }
            },
            "required": [
              "scenario"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "scenario": {
                "const": "version_mismatch"
              }
            },
            "required": [
              "scenario"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "scenario": {
                "const": "no_receiver"
              }
            },
            "required": [
              "scenario"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "scenario": {
                "const": "no_activity"
              }
            },
            "required": [
              "scenario"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    }
  }
}
