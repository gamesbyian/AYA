      "events": [
        "reference_validated",
        "review_opened",
        "review_approved",
        "copy_requested",
        "copy_succeeded"
      ]
    },
    {
      "scenario": "cancel",
      "events": [
        "reference_validated",
        "review_opened",
        "review_cancelled"
      ]
    },
    {
