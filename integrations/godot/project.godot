config_version=5

[application]
config/name="AYA addon editor smoke"
run/main_scene="res://aya_smoke.tscn"

[editor_plugins]
enabled=PackedStringArray("res://addons/AYA/plugin.cfg")

[rendering]

# Godot's Android exporter requires ETC2/ASTC imported textures even on a
# Linux CI host whose default rendering backend prefers desktop formats.
textures/vram_compression/import_etc2_astc=true
